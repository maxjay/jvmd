  {
    "method": "edit.text",
    "tool": {
      "name": "edit",
      "description": "Apply nonoverlapping UTF-16 ranges, optionally guarded by a source SHA-256. Applies a checked source edit and returns live member diagnostics. A change is complete only after diagnostics(verified=true) passes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text_edits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "range": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "object",
                      "properties": {
                        "line": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 2147483647,
                          "default": 0
                        },
                        "character": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 2147483647,
                          "default": 0
                        }
                      },
                      "required": [
                        "line",
                        "character"
                      ],
                      "additionalProperties": false
                    },
                    "end": {
                      "type": "object",
                      "properties": {
                        "line": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 2147483647,
                          "default": 0
                        },
                        "character": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 2147483647,
                          "default": 0
                        }
                      },
                      "required": [
                        "line",
                        "character"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                },
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647,
                  "default": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647,
                  "default": 0
                },
                "new_text": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "new_text"
              ],
              "additionalProperties": false,
              "oneOf": [
                {
                  "required": [
                    "range"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "start"
                        ]
                      },
                      {
                        "required": [
                          "end"
                        ]
                      }
                    ]
                  }
                },
                {
                  "required": [
                    "start",
                    "end"
                  ],
                  "not": {
                    "required": [
                      "range"
                    ]
                  }
                }
              ]
            },
            "minItems": 1,
            "maxItems": 100000
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 100
          },
          "cursor": {
            "type": "string",
            "description": "Continue a previous page using the same arguments.",
            "minLength": 1
          }
        },
        "required": [
          "text_edits"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "openWorldHint": false
      }
    }
  },
